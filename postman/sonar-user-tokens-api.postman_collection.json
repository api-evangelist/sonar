              "id": "171f8e22-f9d6-40a8-b4d2-79b93fec0745",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{bearerToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) Token name",
                      "key": "name",
                      "value": "<string>"
                    },
                    {
                      "description": "Scope token to a specific organization",
                      "key": "organizationKey",
                      "value": "<string>"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/user_tokens/generate",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "user_tokens",
                    "generate"
                  ]
                },
                "description": "Generate a new user token for API authentication. The token value is returned only once and must be stored securely. Tokens can be scoped to specific organizations."
              },
